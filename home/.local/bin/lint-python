#!/usr/bin/env python3
"""Fix, lint, and format Python files with ruff.

Each file uses the ruff in the nearest `.venv/bin/ruff` above it, so a project
gets its pinned version. Without one, it uses `uvx ruff`. It does not call
`uv run`, which would sync the project environment on every edit.

`lint-python a.py b.py` acts on the given files. With no arguments, it reads a
Claude Code hook event on stdin and acts on its `tool_input.file_path`.
Unused imports (F401) are reported, not removed, because the next edit often
uses them. Exit 2 when lint errors remain: a Claude Code hook then shows
stderr to the model.
"""

import json
import os
import subprocess
import sys
from collections import defaultdict
from pathlib import Path


def ruff_for(file: str) -> tuple[str, ...]:
    for parent in Path(file).resolve().parents:
        ruff = parent / ".venv" / "bin" / "ruff"
        if ruff.is_file():
            return (str(ruff),)
    return ("uvx", "ruff")


def main() -> int:
    files = sys.argv[1:] or [
        json.load(sys.stdin).get("tool_input", {}).get("file_path", "")
    ]
    files = [f for f in files if f.endswith(".py")]
    if not files:
        return 0
    # Claude Code can start from a shell where mise is not active.
    os.environ["PATH"] += os.pathsep + os.path.expanduser("~/.local/share/mise/shims")
    groups = defaultdict(list)
    for f in files:
        groups[ruff_for(f)].append(f)
    status = 0
    for ruff, group in groups.items():
        check = subprocess.run(
            [*ruff, "check", "--fix", "--unfixable", "F401", "--quiet", *group],
            stdout=sys.stderr,
        )
        subprocess.run([*ruff, "format", "--quiet", *group])
        if check.returncode != 0:
            status = 2
    return status


if __name__ == "__main__":
    sys.exit(main())
