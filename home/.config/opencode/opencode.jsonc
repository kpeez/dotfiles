{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    // The Mac clones repos under ~/code. Linux servers clone them under ~/repos.
    // Each pair below names one path per layout, so only one exists per
    // machine and no skill loads twice.
    "paths": [
      "{env:HOME}/code/agent-toolbox/plugins/swe/skills",
      "{env:HOME}/repos/agent-toolbox/plugins/swe/skills",
      "{env:HOME}/code/agent-toolbox/plugins/lab/skills",
      "{env:HOME}/repos/agent-toolbox/plugins/lab/skills",
      "{env:HOME}/code/obsidian-skills/plugins/obsidian/skills"
    ]
  },
  "agent": {
    // Backs the Nushell `ask` command: quick answers on a free model, with
    // no file edits or shell access (the default build agent allows both).
    "ask": {
      "description": "Answers quick questions briefly, without changing anything",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "prompt": "Answer the question directly and briefly in plain text.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
