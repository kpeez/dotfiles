# Shell syntax-highlighting palette, applied at every startup.
#
# Captured on 2026-08-22 via `fish_config theme dump` after choosing these
# colors interactively. Set in global scope on purpose: globals shadow
# universal variables, so this wins over whatever a host's local
# `fish_variables` happens to contain — including the defaults fish writes on
# first run and any file fish regenerates on upgrade.
#
# To change colors: edit here directly, or pick new ones interactively
# (`fish_config theme`, or `set -U fish_color_command ...`) and re-capture:
#   fish_config theme dump   # then translate each line to `set --global ...`

set --global fish_color_autosuggestion 585b70
set --global fish_color_cancel fab387 --reverse
set --global fish_color_command a6e3a1
set --global fish_color_comment 6c7086
set --global fish_color_cwd a6e3a1
