[user]
	name = kpeez
	email = krpuhger@gmail.com
[commit]
	gpgSign = false
[http]
	postBuffer = 524288000
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	autoupdate = true
	enabled = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Machine-specific settings (safe.directory, core.hooksPath) go here, untracked.
# A missing include is not an error.
[include]
	path = ~/.config/git/config.local
[url "https://github.com/"]
	insteadOf = git@github.com:
[fetch]
	prune = true
[pull]
	ff = only
[alias]
	# Delete local branches whose remote branch is gone, such as a merged PR
	# branch that GitHub deleted. Squash merges look unmerged, so this uses -D.
	gone = "!git fetch -q --prune && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | while read b t; do [ \"$t\" = '[gone]' ] && git branch -D \"$b\"; done; true"
